# Copy to .env.production on the VPS; chmod 600. Never commit real values.
NEXT_PUBLIC_SITE_URL=https://travel.example.com
SITE_URL=https://travel.example.com
SITE_DOMAIN=travel.example.com
ACME_EMAIL=hello.seatriptravel@gmail.com
APP_BIND_PORT=3080
CMS_ENABLED=1
# Generate once: openssl rand -hex 32. Preserve with backups; loss means unreadable leads.
LEAD_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_COOKIE_SECURE=true
LEAD_HASH_SALT=REPLACE_WITH_RANDOM_SECRET
LEAD_RATE_LIMIT_STORE=memory
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello.seatriptravel@gmail.com
SMTP_PASSWORD=
MAIL_FROM_EMAIL=hello.seatriptravel@gmail.com
MAIL_FROM_NAME=SEA TRIP TRAVEL
SALES_RECIPIENTS=seatriptravel@gmail.com
# Google Cloud Translation Basic v2. Server-side only; restrict the key to the
# Cloud Translation API and keep billing/quota alerts enabled.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT_MS=15000
# Hạn mức miễn phí: app tự chặn trước khi gửi, không phụ thuộc budget alert.
# 0 = không giới hạn. Đặt ngày ≤ quota Google "characters per project per day".
TRANSLATION_DAILY_CHAR_LIMIT=15000
TRANSLATION_MONTHLY_CHAR_LIMIT=450000

# Email thông báo sau mỗi lần deploy main thành công (gửi từ container vừa deploy).
# Để trống thì dùng SALES_RECIPIENTS ở trên. Nhiều địa chỉ: ngăn cách bằng dấu phẩy.
RELEASE_NOTICE_RECIPIENTS=seatriptravel@gmail.com
# Đặt false để tạm tắt email thông báo mà không cần sửa quy trình deploy.
RELEASE_NOTICE_ENABLED=true
