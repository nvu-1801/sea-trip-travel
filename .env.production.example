# Copy to .env.production on the VPS; chmod 600. Never commit real values.
# Addresses below are examples; replace them only in the private VPS file.
NEXT_PUBLIC_SITE_URL=https://travel.example.com
SITE_URL=https://travel.example.com
SITE_DOMAIN=travel.example.com
ACME_EMAIL=mailer@example.com
APP_BIND_PORT=3080
CMS_ENABLED=1
# Generate once: openssl rand -hex 32. Preserve with backups; loss means unreadable leads.
LEAD_ENCRYPTION_KEY=
ADMIN_COOKIE_SECURE=true
LEAD_HASH_SALT=
LEAD_RATE_LIMIT_STORE=memory
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=
MAIL_FROM_EMAIL=mailer@example.com
MAIL_FROM_NAME=SEA TRIP TRAVEL
SALES_RECIPIENTS=sales@example.com

# Email thông báo sau mỗi lần deploy main thành công (gửi từ container vừa deploy).
# Để trống thì dùng SALES_RECIPIENTS ở trên. Nhiều địa chỉ: ngăn cách bằng dấu phẩy.
RELEASE_NOTICE_RECIPIENTS=
# Đặt false để tạm tắt email thông báo mà không cần sửa quy trình deploy.
RELEASE_NOTICE_ENABLED=true
