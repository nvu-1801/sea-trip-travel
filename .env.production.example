# Copy to .env.production on the VPS; chmod 600. Never commit real values.
NEXT_PUBLIC_SITE_URL=https://travel.example.com
SITE_URL=https://travel.example.com
SITE_DOMAIN=travel.example.com
ACME_EMAIL=hello.seatriptravel@gmail.com
APP_BIND_PORT=3080
CMS_ENABLED=1
# Generate once: openssl rand -hex 32. Preserve with backups; loss means unreadable leads.
LEAD_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_COOKIE_SECURE=true
LEAD_HASH_SALT=REPLACE_WITH_RANDOM_SECRET
LEAD_RATE_LIMIT_STORE=memory
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello.seatriptravel@gmail.com
SMTP_PASSWORD=
MAIL_FROM_EMAIL=hello.seatriptravel@gmail.com
MAIL_FROM_NAME=SEA TRIP TRAVEL
SALES_RECIPIENTS=seatriptravel@gmail.com
