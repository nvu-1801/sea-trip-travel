# SEA TRIP backup — cấu hình chạy trên host (không chứa mật khẩu/khóa).
# File thật: /opt/seatrip/.backup.env (root 0600), do `manage.sh install` tạo.
APP_DIR=/opt/seatrip
BACKUP_DIR=/opt/seatrip/backups
BACKUP_VOLUME=seatrip_content
BACKUP_GID=1001
BACKUP_KEEP_AUTO=3
BACKUP_MIN_FREE_BYTES=2147483648
BACKUP_TIMEZONE=Asia/Bangkok
BACKUP_SCHEDULE="*-*-01,16 03:00:00"
BACKUP_IMAGE=seatrip-backup:1

# Để trống = chưa cấu hình offsite (không tự chọn dịch vụ, không phát sinh chi phí).
# Ví dụ thư mục ổ ngoài/NFS đã mount trên VPS:
# BACKUP_OFFSITE_DIR=/mnt/offsite/seatrip
BACKUP_OFFSITE_DIR=
