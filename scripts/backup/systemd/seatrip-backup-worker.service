[Unit]
Description=SEA TRIP backup request worker (admin button bridge)
Documentation=file:@APP_DIR@/bin/backup/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=BACKUP_CONFIG=@APP_DIR@/.backup.env
ExecStart=@MANAGE@ worker
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
TimeoutStartSec=2h
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target
