# =============================================================================
# SEA TRIP TRAVEL — environment variables
# Copy to `.env.local` for development. Never commit real secrets.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Used for canonical URLs, Open Graph, sitemap and links inside the sales email.
# Must be the real public origin (scheme + host, no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead intake -------------------------------------------------------------
# Comma-separated list of mailboxes that receive "Yêu cầu tư vấn mới".
# Configured server-side only — the client cannot choose the recipient.
SALES_RECIPIENTS=sales@example.com

# Salt used to hash the client fingerprint for rate limiting. Use a long random
# string. Rotating it resets rate-limit buckets (which is harmless).
LEAD_HASH_SALT=change-me-to-a-long-random-string

# --- Mail transport ----------------------------------------------------------
# `log`   → development only: writes a redacted line to the server log and does
#           NOT send. In production this returns MAIL_NOT_CONFIGURED instead of
#           pretending the request was delivered.
# `smtp`  → sends through SMTP (nodemailer).
MAIL_TRANSPORT=log

# From address. The domain MUST be verified with your mail provider and have
# SPF/DKIM/DMARC configured, otherwise the mail will be filtered.
MAIL_FROM_NAME=SEA TRIP TRAVEL
MAIL_FROM_EMAIL=no-reply@example.com

# SMTP settings (only read when MAIL_TRANSPORT=smtp).
# Port 587 with SMTP_SECURE=false uses STARTTLS (recommended).
# Port 465 with SMTP_SECURE=true uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
