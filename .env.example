# =============================================================================
# SEA TRIP TRAVEL — environment variables
# Copy to `.env.local` for development. NEVER commit real secrets.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Used for canonical URLs, Open Graph, sitemap and the links inside the sales
# email. Must be the real public origin (scheme + host, no trailing slash).
# TODO(owner): đổi thành domain thật sau khi trỏ DNS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead intake -------------------------------------------------------------
# Comma-separated mailboxes that receive "Yêu cầu tư vấn mới".
# Server-side only — the client cannot choose the recipient.
SALES_RECIPIENTS=seatriptravel@gmail.com

# Salt used to hash the client fingerprint for rate limiting and idempotency.
# Use a long random string. Rotating it only resets those buckets.
LEAD_HASH_SALT=change-me-to-a-long-random-string

# --- Shared store for rate limiting + idempotency ----------------------------
# `memory` (default) keeps counters in this process. That is correct for a single
# long-lived instance (a VPS, or `next dev`), but on serverless / multiple
# instances the limits do NOT hold across invocations. When the app runs in
# production with `memory` it logs a warning telling you exactly this.
#
# `rest` uses any Redis reachable over HTTP (Upstash, Vercel KV…), shared by every
# instance. Set it before scaling out.
LEAD_RATE_LIMIT_STORE=memory
LEAD_RATE_LIMIT_URL=
LEAD_RATE_LIMIT_TOKEN=

# --- Mail transport ----------------------------------------------------------
# `log`   → development only: writes a redacted line to the server log and does
#           NOT send. In production it returns MAIL_NOT_CONFIGURED instead of
#           pretending the request was delivered.
# `smtp`  → sends through SMTP (nodemailer).
MAIL_TRANSPORT=log

# From address. With Gmail SMTP this must be the authenticated Gmail account —
# Gmail rewrites the From header to it anyway. If a domain mailbox is set up
# later, use that instead and keep the SPF/DKIM/DMARC records aligned.
MAIL_FROM_NAME=SEA TRIP TRAVEL
MAIL_FROM_EMAIL=seatriptravel@gmail.com

# SMTP settings (only read when MAIL_TRANSPORT=smtp).
#
# Gmail / Google Workspace — the current MVP path:
#   1. Bật xác minh 2 bước cho tài khoản Google.
#   2. Tạo "Mật khẩu ứng dụng" (App Password) 16 ký tự và dán vào SMTP_PASSWORD.
#      KHÔNG dùng mật khẩu đăng nhập Google.
#   3. Gmail có giới hạn số thư gửi mỗi ngày cho tài khoản miễn phí — kiểm tra
#      trang chính sách hiện hành của Google trước khi chạy quảng cáo lớn.
#
# Port 587 with SMTP_SECURE=false uses STARTTLS (recommended).
# Port 465 with SMTP_SECURE=true uses implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seatriptravel@gmail.com
SMTP_PASSWORD=

# =============================================================================
# Admin / CMS backend (SQLite + file uploads)
# =============================================================================
# Where the site reads its content from.
#   sqlite  (default) → this instance owns the database; serves the admin area.
#                       Use this on the VPS (or locally).
#   remote            → this instance has NO database. It reads published
#                       content from CONTENT_API_BASE_URL and disables /admin.
#                       Use this for a Vercel deployment of the public site.
CONTENT_SOURCE=sqlite

# Base URL of the backend's public content API. Required when
# CONTENT_SOURCE=remote, e.g. https://api.seatriptravel.vn
# (must expose GET /api/public/content).
CONTENT_API_BASE_URL=

# SQLite file. MUST live on a persistent disk, never on a serverless filesystem
# and never inside `public/`. Relative paths resolve from the project root.
DATABASE_PATH=./data/sea-trip.db

# Uploaded images. Also on the persistent disk. The 28 approved photographs stay
# in `public/images/tours` and are not moved.
UPLOAD_DIR=./data/uploads

# Max original upload size in bytes (default 10 MB).
MEDIA_MAX_BYTES=10485760

# Long random string used to salt session/fingerprint hashes. Rotating it
# invalidates only those hashes (nobody is logged out of anything else).
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Set to false to serve the read-only public site from an instance that still
# has a database (e.g. a staging mirror) without exposing /admin.
ADMIN_ENABLED=true

# Import the shipped content on first boot when the database is empty and
# NODE_ENV !== production. Production seeds explicitly with `npm run db:import`.
SEED_ON_BOOT=false

